# ─────────────────────────────────────────────────────────────────────────────
# BuildStack — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and must NEVER be committed.
#
# How to find these values:
#   Firebase Console → Your Project → Project Settings → Your Apps → Web App
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web App configuration (all NEXT_PUBLIC_ values are safe in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ─────────────────────────────────────────────────────────────────────────────
# Backend API base URL (used when calling the Express server from the frontend)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
